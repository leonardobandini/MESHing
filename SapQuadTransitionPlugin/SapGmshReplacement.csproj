<Project Sdk="Microsoft.NET.Sdk">
  <!-- Release build: Gmsh V2 uses the existing V1 COM identity and Tools entry. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>SapQuadTransitionPlugin</AssemblyName>
    <RootNamespace>SapQuadTransitionPlugin</RootNamespace>
    <DefineConstants>$(DefineConstants);GMSH_V2;GMSH_V2_REPLACE_V1</DefineConstants>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Version>3.0.3</Version>
    <FileVersion>3.0.3.0</FileVersion>
    <CSiApiPath Condition="'$(CSiApiPath)' == '' and Exists('$(Sap2000InstallDir)\CSiAPIv1.dll')">$(Sap2000InstallDir)\CSiAPIv1.dll</CSiApiPath>
    <CSiApiPath Condition="'$(CSiApiPath)' == '' and Exists('$(CSiBridgeInstallDir)\CSiAPIv1.dll')">$(CSiBridgeInstallDir)\CSiAPIv1.dll</CSiApiPath>
    <CSiApiPath Condition="'$(CSiApiPath)' == ''">$(CSiBridgeInstallDir)\CSiAPIv1.dll</CSiApiPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PluginV2.cs" />
    <Compile Include="GmshPreviewPanel.cs" />
    <Compile Include="ModelCsvSnapshot.cs" />
    <Reference Include="CSiAPIv1"><HintPath>$(CSiApiPath)</HintPath><EmbedInteropTypes>false</EmbedInteropTypes><Private>false</Private></Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <None Include="sap_gmsh_mesher.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\docs\help-gmsh-v2\**\*" Link="docs\help-gmsh-v2\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\img\quad-mesher.ico" Link="img\quad-mesher.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\img\quad-mesher-icon.svg" Link="img\quad-mesher-icon.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\img\logo.png" Link="img\logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateCSiApi" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(CSiApiPath)')">
    <Error Text="CSiAPIv1.dll non trovata. Installare SAP2000 o CSiBridge 27+, oppure impostare CSiApiPath con il percorso della xOAPI installata." />
  </Target>
</Project>
